{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "streamlapse-scheduler",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-27",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": false,
  "preview_urls": false,
  "observability": {
    "enabled": true,
    "logs": {
      "enabled": true,
      "invocation_logs": true,
      "head_sampling_rate": 1
    }
  },
  "secrets": {
    "required": ["GITHUB_TOKEN"]
  },
  "triggers": {
    "crons": ["*/5 * * * *"]
  }
}
